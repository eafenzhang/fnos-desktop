{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-only",
  "description": "只允许设置窗调用应用命令；远程页面无任何授权（Task 11 的 get_page_state 与 Task 13a 的 get_page_report 同样只授设置窗；页面→宿主上报走 document.title，不占任何权限）",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-config",
    "allow-set-config",
    "allow-reload-main",
    "allow-open-config-dir",
    "allow-open-url",
    "allow-reset-config",
    "allow-get-page-state",
    "allow-get-page-report"
  ]
}
