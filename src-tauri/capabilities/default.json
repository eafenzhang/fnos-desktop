{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-only",
  "description": "只允许设置窗调用应用命令；远程页面无任何授权",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-config",
    "allow-set-config",
    "allow-reload-main",
    "allow-open-config-dir",
    "allow-open-url",
    "allow-reset-config"
  ]
}
