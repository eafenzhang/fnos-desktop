{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fnOS",
  "version": "0.1.0",
  "identifier": "com.fnos.desktop",
  "build": {
    "frontendDist": "../ui/settings"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "assets/fnos-mods/LICENSE": "fnos-mods/LICENSE",
      "assets/fnos-mods/NOTICE": "fnos-mods/NOTICE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
